# Copy this file to ".env" and fill in your real values.
# NEVER commit the actual ".env" file to GitHub.

# Database (SQLite) — leave DB_PATH as-is unless you want a custom location
DB_PATH=database.db

# Email alerts (use a Gmail App Password, not your real Gmail password)
ALERT_EMAIL=your_email@gmail.com
ALERT_EMAIL_PASSWORD=your_app_password
ALERT_RECEIVERS=email1@example.com,email2@example.com

# Render sets this automatically — no need to set it yourself
# RENDER=true
